{
  "name": "wuhan-wenyanwen-app",
  "private": true,
  "version": "2.0.0",
  "description": "武汉中考 · 初中语文文言文学习练习 App (React 重构版)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:build": "node scripts/build-runtime-data.mjs",
    "typecheck": "tsc --noEmit",
